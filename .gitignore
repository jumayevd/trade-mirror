# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# trade-mirror raw data cache (regenerated by `npm run data:fetch`)
/data/raw

.vercel

# personal files not part of the project
Soft Collection Recovery.xlsx
*.xlsx

# monthly HS6 detail (40MB) — regenerated by npm run data:monthly, uploaded to Vercel from local
/public/data/monthly-hs6.json

# raw UN Comtrade monthly chunk downloads (827MB) — input to npm run data:quantity
/comtrade_monthly_chunks

# HS6 quantity & unit-price layer (17MB) — regenerated by npm run data:quantity,
# uploaded to Vercel from local, same as monthly-hs6.json
/public/data/quantity-hs6.json

# live-API response cache for scripts/audit-vs-comtrade.ts
/data/raw/audit-cache
