# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# trade-mirror raw data cache (regenerated by `npm run data:fetch`)
/data/raw

.vercel

# personal files not part of the project
Soft Collection Recovery.xlsx
*.xlsx

# monthly HS6 detail (40MB) — regenerated by npm run data:monthly, uploaded to Vercel from local
# The two public/data layers are COMMITTED, not ignored: Vercel deploys this
# repo from git, and their sources (the 827MB chunk folder, the monthly
# workbook) are not here, so a build cannot regenerate them. Ignoring them
# made every git-triggered deploy 404 both files.

# raw UN Comtrade monthly chunk downloads (827MB) — input to npm run data:quantity
/comtrade_monthly_chunks


# live-API response cache for scripts/audit-vs-comtrade.ts
/data/raw/audit-cache
